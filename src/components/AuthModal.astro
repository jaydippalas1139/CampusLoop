---
// src/components/AuthModal.astro
---

<!-- Auth Modal Backdrop -->
<div 
  id="auth-modal" 
  class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 bg-slate-950/80 backdrop-blur-md transition-opacity duration-200"
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="auth-modal-title"
>
  <div class="relative w-full max-w-md bg-slate-900 border border-slate-700/80 rounded-3xl shadow-2xl overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-900/90">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div>
          <h2 id="auth-modal-title" class="text-base font-bold text-white">CampusLoop Account</h2>
          <p class="text-[11px] text-slate-400">Student Sign In & Registration</p>
        </div>
      </div>

      <button 
        type="button" 
        id="close-auth-modal-btn" 
        class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition-colors duration-150"
        aria-label="Close Auth Modal"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Tabs: Sign In / Sign Up -->
    <div class="flex border-b border-slate-800 bg-slate-950/60 p-1.5 gap-1.5" role="tablist">
      <button 
        type="button" 
        id="tab-btn-login"
        class="flex-1 py-2 px-3 text-xs font-bold rounded-xl bg-emerald-500 text-slate-950 shadow-sm transition-all duration-150"
        role="tab"
        aria-selected="true"
      >
        Sign In
      </button>
      <button 
        type="button" 
        id="tab-btn-register"
        class="flex-1 py-2 px-3 text-xs font-bold rounded-xl bg-slate-800 text-slate-300 hover:text-white transition-all duration-150"
        role="tab"
        aria-selected="false"
      >
        Create Account
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6 overflow-y-auto space-y-4">
      <!-- Quick Demo Login Bar -->
      <div class="p-3 bg-slate-950 rounded-2xl border border-slate-800 text-xs">
        <span class="text-[10px] uppercase font-bold text-slate-500 block mb-2">Quick 1-Click Demo Profiles:</span>
        <div class="flex flex-wrap gap-2">
          <button 
            type="button" 
            class="demo-login-btn px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-emerald-950 hover:text-emerald-300 border border-slate-700 text-[11px] font-semibold text-slate-200 transition-colors"
            data-email="dipesh@campusloop.in"
          >
            Dipesh (CSE)
          </button>
          <button 
            type="button" 
            class="demo-login-btn px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-emerald-950 hover:text-emerald-300 border border-slate-700 text-[11px] font-semibold text-slate-200 transition-colors"
            data-email="ajay@campusloop.in"
          >
            Ajay (Calculator Owner)
          </button>
          <button 
            type="button" 
            class="demo-login-btn px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-emerald-950 hover:text-emerald-300 border border-slate-700 text-[11px] font-semibold text-slate-200 transition-colors"
            data-email="nisarg@campusloop.in"
          >
            Nisarg (Arduino Owner)
          </button>
        </div>
      </div>

      <!-- FORM 1: LOGIN -->
      <form id="login-form" class="space-y-4">
        <div>
          <label for="login-email-input" class="block text-xs font-semibold text-slate-300 mb-1.5">
            College Email *
          </label>
          <input 
            type="email" 
            id="login-email-input" 
            name="email" 
            required 
            placeholder="e.g. dipesh@campusloop.in" 
            class="w-full px-3.5 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500"
          />
        </div>

        <div>
          <label for="login-password-input" class="block text-xs font-semibold text-slate-300 mb-1.5">
            Password *
          </label>
          <input 
            type="password" 
            id="login-password-input" 
            name="password" 
            required 
            placeholder="••••••••" 
            class="w-full px-3.5 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500"
          />
        </div>

        <button 
          type="submit" 
          id="login-submit-btn"
          class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-sm shadow-lg shadow-emerald-500/20 transition-all duration-150 active:scale-95"
        >
          Sign In to CampusLoop
        </button>
      </form>

      <!-- FORM 2: REGISTER -->
      <form id="register-form" class="hidden space-y-3">
        <div>
          <label for="register-name-input" class="block text-xs font-semibold text-slate-300 mb-1">
            Full Name *
          </label>
          <input 
            type="text" 
            id="register-name-input" 
            name="name" 
            required 
            placeholder="Your Name" 
            class="w-full px-3 py-1.5 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500"
          />
        </div>

        <div>
          <label for="register-email-input" class="block text-xs font-semibold text-slate-300 mb-1">
            College Email *
          </label>
          <input 
            type="email" 
            id="register-email-input" 
            name="email" 
            required 
            placeholder="student@campusloop.in" 
            class="w-full px-3 py-1.5 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500"
          />
        </div>

        <div>
          <label for="register-dept-input" class="block text-xs font-semibold text-slate-300 mb-1">
            Department *
          </label>
          <select 
            id="register-dept-input" 
            name="department" 
            required 
            class="w-full px-3 py-1.5 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:border-emerald-500"
          >
            <option value="Computer Science & Engineering">Computer Science & Engineering</option>
            <option value="Information Technology">Information Technology</option>
            <option value="Mechanical Engineering">Mechanical Engineering</option>
            <option value="Chemical Sciences">Chemical Sciences</option>
            <option value="Civil Engineering">Civil Engineering</option>
          </select>
        </div>

        <div>
          <label for="register-password-input" class="block text-xs font-semibold text-slate-300 mb-1">
            Password *
          </label>
          <input 
            type="password" 
            id="register-password-input" 
            name="password" 
            required 
            placeholder="At least 6 characters" 
            class="w-full px-3 py-1.5 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500"
          />
        </div>

        <button 
          type="submit" 
          id="register-submit-btn"
          class="w-full py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-xs shadow-lg shadow-emerald-500/20 transition-all duration-150 active:scale-95"
        >
          Create Account (+100 Green Points)
        </button>
      </form>
    </div>
  </div>
</div>
