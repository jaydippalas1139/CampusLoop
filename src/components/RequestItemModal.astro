---
// src/components/RequestItemModal.astro
---

<!-- Request Item Modal Backdrop -->
<div 
  id="request-item-modal" 
  class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 bg-slate-950/80 backdrop-blur-md transition-opacity duration-200"
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="request-modal-title"
>
  <div class="relative w-full max-w-md bg-slate-900 border border-slate-700/80 rounded-3xl shadow-2xl overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-900/90">
      <div>
        <h2 id="request-modal-title" class="text-base font-bold text-white">Send Resource Request</h2>
        <p class="text-[11px] text-slate-400">CampusLoop Owner-Approval Handshake</p>
      </div>

      <button 
        type="button" 
        id="close-request-modal-btn" 
        class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition-colors duration-150"
        aria-label="Close Request Modal"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Body -->
    <form id="item-request-form" class="p-6 space-y-4">
      <div class="bg-slate-950 p-3.5 rounded-2xl border border-slate-800">
        <span class="text-[10px] uppercase font-bold text-emerald-400 tracking-wider block">Target Resource</span>
        <div id="request-target-title" class="text-sm font-bold text-white mt-0.5">Casio fx-991EX Scientific Calculator</div>
        <div id="request-target-owner" class="text-xs text-slate-400 mt-0.5">Owner: Ajay Vaniya (CSE)</div>
      </div>

      <div>
        <label for="request-duration-select" class="block text-xs font-semibold text-slate-300 mb-1.5">
          Requested Borrow Duration *
        </label>
        <select 
          id="request-duration-select" 
          required 
          class="w-full px-3 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:border-emerald-500"
        >
          <option value="3">3 Days (Quick Exam / Assignment)</option>
          <option value="7">7 Days (1 Week Study Period)</option>
          <option value="14" selected>14 Days (Standard Two-Week Module)</option>
          <option value="30">30 Days (Full Lab Coursework)</option>
        </select>
      </div>

      <div>
        <label for="request-meeting-spot" class="block text-xs font-semibold text-slate-300 mb-1.5">
          Proposed Campus Handover Spot *
        </label>
        <select 
          id="request-meeting-spot" 
          required 
          class="w-full px-3 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:border-emerald-500"
        >
          <option value="Library Ground Floor Foyer">Library Ground Floor Foyer (Recommended)</option>
          <option value="C-Block Atrium / Reception">C-Block Atrium / Reception</option>
          <option value="Tech Cafeteria Central Gazebo">Tech Cafeteria Central Gazebo</option>
          <option value="Mechanical Workshop Room 104">Mechanical Workshop Room 104</option>
        </select>
      </div>

      <div>
        <label for="request-notes-input" class="block text-xs font-semibold text-slate-300 mb-1.5">
          Message to Owner
        </label>
        <input 
          type="text" 
          id="request-notes-input" 
          placeholder="Hi! Need this for next Tuesday's Engineering exam…" 
          class="w-full px-3.5 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500"
        />
      </div>

      <div class="pt-2">
        <button 
          type="submit" 
          class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-sm shadow-lg shadow-emerald-500/20 transition-all duration-150 active:scale-95"
        >
          Confirm & Send Handover Request
        </button>
      </div>
    </form>
  </div>
</div>
