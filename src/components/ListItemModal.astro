---
// src/components/ListItemModal.astro
---

<!-- List Resource Modal Backdrop -->
<div 
  id="list-item-modal" 
  class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 bg-slate-950/80 backdrop-blur-md transition-opacity duration-200"
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="list-modal-title"
>
  <div class="relative w-full max-w-lg bg-slate-900 border border-slate-700/80 rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-900/90">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold">
          +
        </div>
        <div>
          <h2 id="list-modal-title" class="text-base font-bold text-white">List a Campus Resource</h2>
          <p class="text-[11px] text-slate-400">Share with verified campus students</p>
        </div>
      </div>

      <button 
        type="button" 
        id="close-list-modal-btn" 
        class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition-colors duration-150"
        aria-label="Close List Resource Modal"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Form Body -->
    <form id="new-item-form" class="p-6 overflow-y-auto space-y-4">
      <div>
        <label for="item-title-input" class="block text-xs font-semibold text-slate-300 mb-1.5">
          Item Title *
        </label>
        <input 
          type="text" 
          id="item-title-input" 
          name="title" 
          required 
          placeholder="e.g. Casio fx-991CW Calculator, Arduino Mega, Heat Transfer Book…" 
          class="w-full px-3.5 py-2 text-xs sm:text-sm bg-slate-950 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
        />
      </div>

      <!-- Photo Upload & Choose Image -->
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
          Item Photo *
        </label>
        <div class="flex items-center gap-4">
          <!-- Live Preview Box -->
          <div id="image-preview-box" class="w-20 h-20 rounded-xl bg-slate-950 border-2 border-dashed border-slate-700 overflow-hidden flex items-center justify-center text-slate-500 shrink-0">
            <img id="image-preview" src="/images/arduino_kit.jpg" alt="Preview" class="w-full h-full object-cover hidden" />
            <div id="image-placeholder-icon" class="text-slate-500">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
          </div>

          <div class="flex-1 space-y-2">
            <!-- Custom File Input -->
            <label 
              for="item-image-file" 
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 cursor-pointer transition-colors"
            >
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
              <span>Upload Photo from Device</span>
            </label>
            <input type="file" id="item-image-file" accept="image/*" class="sr-only" />

            <div class="text-[11px] text-slate-400">
              Or pick preset:
              <select id="preset-image-select" class="ml-1 bg-slate-800 border border-slate-700 rounded-lg px-2 py-0.5 text-[11px] text-slate-300">
                <option value="/images/arduino_kit.jpg">Electronics / Kit</option>
                <option value="/images/calculator.jpg">Scientific Calculator</option>
                <option value="/images/textbooks.jpg">Textbooks / Notes</option>
                <option value="/images/mini_drafter.jpg">Workshop / Lab Gear</option>
              </select>
            </div>
          </div>
        </div>
        <input type="hidden" id="final-image-url" name="image_url" value="/images/arduino_kit.jpg" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="item-category-input" class="block text-xs font-semibold text-slate-300 mb-1.5">
            Category *
          </label>
          <select 
            id="item-category-input" 
            name="category" 
            required 
            class="w-full px-3 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:border-emerald-500"
          >
            <option value="Calculators">Calculators</option>
            <option value="Electronics">Electronics & MCUs</option>
            <option value="Books & Notes">Books & Exam Notes</option>
            <option value="Lab & Workshop Gear">Lab & Workshop Gear</option>
          </select>
        </div>

        <div>
          <label for="item-action-input" class="block text-xs font-semibold text-slate-300 mb-1.5">
            Action Type *
          </label>
          <select 
            id="item-action-input" 
            name="actionType" 
            required 
            class="w-full px-3 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:border-emerald-500"
          >
            <option value="borrow">Borrow / Lend (Short Term)</option>
            <option value="exchange">Exchange / Swap (Semester)</option>
            <option value="donate">Free Donation (Pass-It-On)</option>
            <option value="buy">Buy / Sell (Second Hand)</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="item-condition-input" class="block text-xs font-semibold text-slate-300 mb-1.5">
            Item Condition *
          </label>
          <select 
            id="item-condition-input" 
            name="condition" 
            required 
            class="w-full px-3 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:border-emerald-500"
          >
            <option value="Like New">Like New (Flawless)</option>
            <option value="Good Condition">Good Condition (Clean)</option>
            <option value="Functional">Functional (Signs of use)</option>
          </select>
        </div>

        <div>
          <label for="item-department-input" class="block text-xs font-semibold text-slate-300 mb-1.5">
            Department *
          </label>
          <select 
            id="item-department-input" 
            name="department" 
            required 
            class="w-full px-3 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:border-emerald-500"
          >
            <option value="CSE">Computer Science & Engg</option>
            <option value="IT">Information Technology</option>
            <option value="Mechanical">Mechanical Engineering</option>
            <option value="Chemical">Chemical Sciences</option>
          </select>
        </div>
      </div>

      <div>
        <label for="item-location-input" class="block text-xs font-semibold text-slate-300 mb-1.5">
          Campus Handover Location *
        </label>
        <select 
          id="item-location-input" 
          name="location" 
          required 
          class="w-full px-3 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:border-emerald-500"
        >
          <option value="Library Ground Floor Foyer">Library Ground Floor Foyer</option>
          <option value="C-Block Atrium / Reception">C-Block Atrium / Reception</option>
          <option value="Tech Cafeteria Central Gazebo">Tech Cafeteria Central Gazebo</option>
          <option value="Mechanical Workshop Room 104">Mechanical Workshop Room 104</option>
          <option value="Sports Complex Entry Gate">Sports Complex Entry Gate</option>
        </select>
      </div>

      <div>
        <label for="item-desc-input" class="block text-xs font-semibold text-slate-300 mb-1.5">
          Description & Notes
        </label>
        <textarea 
          id="item-desc-input" 
          name="description" 
          rows="2" 
          placeholder="Components included, course codes, or swap preferences…"
          class="w-full px-3.5 py-2 text-xs bg-slate-950 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-500 focus:outline-none focus:border-emerald-500"
        ></textarea>
      </div>

      <div class="pt-2">
        <button 
          type="submit" 
          class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-sm shadow-lg shadow-emerald-500/20 transition-all duration-150 active:scale-95"
        >
          Publish Resource Listing (+20 Green Points)
        </button>
      </div>
    </form>
  </div>
</div>
